# LLM: GPU 서버 Ollama 를 SSH 터널로 호출 (ssh -N -L 11434:localhost:11434 user@서버)
LLM_PROVIDER=ollama
LLM_MODEL=gpt-oss:20b
OLLAMA_BASE_URL=http://localhost:11434
LLM_THINK=low
LLM_TIMEOUT_SEC=8
LLM_KEEP_ALIVE=60m

# STT: faster-whisper. GPU 여유 4GB 이상이면 large-v3-turbo + cuda + float16
STT_PROVIDER=faster-whisper
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

DB_PATH=data/warehouse.db
NODE_DELAY_SEC=0.3
